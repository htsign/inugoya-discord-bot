{
  "main": "index.ts",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "imports": {
    "#bot/*": "./bot/*",
    "#lib/*": "./bot/lib/*",
    "#client": "./bot/client.ts",
    "#listeners": "./bot/listeners.ts",
    "#types": "./types/index.ts",
    "#types/*": "./types/*/index.ts"
  },
  "scripts": {
    "start": "dotenvx run -- node index.ts",
    "type-check": "tsc --project ./tsconfig.json",
    "verify": "biome check . && dprint check",
    "verify:fix": "biome check --write . && dprint fmt",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.23.0",
    "@the-convocation/twitter-scraper": "^0.22.3",
    "better-sqlite3": "^13.0.3",
    "chardet": "^2.2.0",
    "dayjs": "^1.11.23",
    "discord.js": "^14.27.0",
    "dprint": "^0.56.1",
    "emoji-regex": "^10.6.0",
    "fast-average-color-node": "^3.2.0",
    "i18next": "^26.4.2",
    "icojs": "^1.0.1",
    "jsdom": "30.0.0",
    "mersenne-twister": "^1.1.0",
    "runes2": "^1.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/mersenne-twister": "^1.1.7",
    "@types/tough-cookie": "^4.0.5",
    "ts-array-length": "^0.1.3",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "dprint@0.56.1": true,
    "sharp@0.34.5": true,
    "better-sqlite3@13.0.3": true
  }
}
